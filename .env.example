# Site URL (e.g. https://example.com). Defaults to https://www.junian.dev
NUXT_PUBLIC_SITE_URL=

# Site base URL (e.g. / for root, /my-app/ for subpath). Defaults to /markdown-resume/
NUXT_PUBLIC_SITE_BASE_URL=

# Google Fonts
NUXT_PUBLIC_GOOGLE_FONTS_KEY=

# GA4 Measurement ID
NUXT_PUBLIC_SCRIPTS_GOOGLE_ANALYTICS_ID=

# Disqus shortname
NUXT_PUBLIC_DISQUS_SHORTNAME=
